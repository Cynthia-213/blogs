---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/links';
import { formatDate } from '../../lib/posts';

type Post = CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
---

<BaseLayout title={post.data.title} description={post.data.description} wide>
  <div class="article-layout">
    {
      tocHeadings.length > 0 && (
        <aside class="article-toc">
          <details open>
            <summary>文章目录</summary>
            <nav aria-label="文章目录">
              <ol>
                {tocHeadings.map((heading) => (
                  <li class={`toc-level-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>
      )
    }
    <article class="article">
      <header class="article-header">
        <a class="back-link" href={withBase('/')}>← Back Home</a>
        <h1>{post.data.title}</h1>
        <p>Posted at {formatDate(post.data.date)}</p>
        {
          post.data.tags.length > 0 && (
            <ul class="tags" aria-label="文章标签">
              {post.data.tags.map((tag) => (
                <li>
                  <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>

  <div class="note-tools" data-note-tools data-post-id={post.id}>
    <button
      class="notes-toggle"
      type="button"
      data-notes-toggle
      aria-controls="article-notes-panel"
      aria-expanded="false"
    >
      笔记 <span data-notes-count>0</span>
    </button>

    <div class="selection-actions" data-selection-actions hidden>
      <button class="selection-action" type="button" data-add-highlight>高亮</button>
      <button class="selection-action" type="button" data-add-selection>添加笔记</button>
    </div>

    <section class="notes-panel" id="article-notes-panel" data-notes-panel hidden aria-labelledby="notes-title">
      <header class="notes-panel-header">
        <h2 id="notes-title">我的笔记</h2>
        <button class="notes-close" type="button" data-notes-close aria-label="关闭笔记">×</button>
      </header>

      <div class="notes-panel-content">
        <form class="note-form" data-note-form hidden>
          <p class="note-form-heading" data-note-form-heading>添加笔记</p>
          <blockquote class="note-quote" data-note-quote></blockquote>
          <label for="note-content">笔记内容</label>
          <textarea id="note-content" data-note-content rows="5" required></textarea>
          <div class="note-form-actions">
            <button class="button-secondary" type="button" data-note-cancel>取消</button>
            <button class="button-primary" type="submit">保存</button>
          </div>
        </form>

        <p class="notes-empty" data-notes-empty>还没有笔记</p>
        <ul class="notes-list" data-notes-list></ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type Note = {
    id: string;
    quote: string;
    content: string;
    createdAt: string;
    updatedAt: string;
  };

  type Highlight = {
    id: string;
    quote: string;
    start: number;
  };

  const root = document.querySelector<HTMLElement>('[data-note-tools]');
  const article = document.querySelector<HTMLElement>('.prose');
  const articleLayout = document.querySelector<HTMLElement>('.article-layout');

  if (root && article) {
    const postId = root.dataset.postId ?? 'article';
    const storageKey = `blog-notes:${postId}`;
    const highlightStorageKey = `blog-highlights:${postId}`;
    const selectionActions = root.querySelector<HTMLElement>('[data-selection-actions]');
    const highlightAction = root.querySelector<HTMLButtonElement>('[data-add-highlight]');
    const selectionAction = root.querySelector<HTMLButtonElement>('[data-add-selection]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-notes-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-notes-panel]');
    const closePanel = root.querySelector<HTMLButtonElement>('[data-notes-close]');
    const form = root.querySelector<HTMLFormElement>('[data-note-form]');
    const formHeading = root.querySelector<HTMLElement>('[data-note-form-heading]');
    const quoteElement = root.querySelector<HTMLElement>('[data-note-quote]');
    const contentInput = root.querySelector<HTMLTextAreaElement>('[data-note-content]');
    const cancelButton = root.querySelector<HTMLButtonElement>('[data-note-cancel]');
    const emptyState = root.querySelector<HTMLElement>('[data-notes-empty]');
    const list = root.querySelector<HTMLUListElement>('[data-notes-list]');
    const count = root.querySelector<HTMLElement>('[data-notes-count]');

    if (
      selectionAction &&
      selectionActions &&
      highlightAction &&
      toggle &&
      panel &&
      closePanel &&
      form &&
      formHeading &&
      quoteElement &&
      contentInput &&
      cancelButton &&
      emptyState &&
      list &&
      count
    ) {
      let notes = readNotes();
      let highlights = readHighlights();
      let selectedQuote = '';
      let selectedStart = 0;
      let editingId: string | null = null;

      function readNotes(): Note[] {
        try {
          const stored = localStorage.getItem(storageKey);
          const parsed = stored ? JSON.parse(stored) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }

      function saveNotes() {
        localStorage.setItem(storageKey, JSON.stringify(notes));
      }

      function readHighlights(): Highlight[] {
        try {
          const stored = localStorage.getItem(highlightStorageKey);
          const parsed = stored ? JSON.parse(stored) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }

      function saveHighlights() {
        localStorage.setItem(highlightStorageKey, JSON.stringify(highlights));
      }

      function makeId() {
        return crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`;
      }

      function getTextOffset(container: Node, offset: number) {
        const range = document.createRange();
        range.selectNodeContents(article);
        range.setEnd(container, offset);
        return range.toString().length;
      }

      function getTextPosition(offset: number) {
        const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT);
        let currentOffset = 0;
        let lastNode: Text | null = null;
        let node: Text | null;

        while ((node = walker.nextNode() as Text | null)) {
          lastNode = node;
          const nextOffset = currentOffset + node.nodeValue.length;
          if (offset <= nextOffset) {
            return { node, offset: Math.max(0, offset - currentOffset) };
          }
          currentOffset = nextOffset;
        }

        return lastNode ? { node: lastNode, offset: lastNode.nodeValue.length } : null;
      }

      function applyHighlight(highlight: Highlight) {
        const start = getTextPosition(highlight.start);
        const end = getTextPosition(highlight.start + highlight.quote.length);
        if (!start || !end) return false;

        const range = document.createRange();
        range.setStart(start.node, start.offset);
        range.setEnd(end.node, end.offset);

        for (const existing of article.querySelectorAll('mark[data-user-highlight]')) {
          if (range.intersectsNode(existing)) return false;
        }

        const mark = document.createElement('mark');
        mark.dataset.userHighlight = 'true';
        mark.dataset.highlightId = highlight.id;
        mark.append(range.extractContents());
        range.insertNode(mark);
        return true;
      }

      function restoreHighlights() {
        for (const highlight of [...highlights].sort((a, b) => b.start - a.start)) {
          applyHighlight(highlight);
        }
      }

      function updatePanel() {
        count.textContent = String(notes.length);
        emptyState.hidden = notes.length > 0;
        list.replaceChildren();

        for (const note of notes) {
          const item = document.createElement('li');
          item.className = 'note-item';

          const quote = document.createElement('blockquote');
          quote.className = 'note-item-quote';
          quote.textContent = note.quote;

          const content = document.createElement('p');
          content.className = 'note-item-content';
          content.textContent = note.content;

          const date = document.createElement('time');
          date.className = 'note-item-date';
          date.dateTime = note.updatedAt;
          date.textContent = new Date(note.updatedAt).toLocaleString('zh-CN', {
            dateStyle: 'medium',
            timeStyle: 'short'
          });

          const actions = document.createElement('div');
          actions.className = 'note-item-actions';

          const edit = document.createElement('button');
          edit.className = 'note-action';
          edit.type = 'button';
          edit.textContent = '编辑';
          edit.addEventListener('click', () => openForm(note.quote, note));

          const remove = document.createElement('button');
          remove.className = 'note-action note-action-danger';
          remove.type = 'button';
          remove.textContent = '删除';
          remove.addEventListener('click', () => {
            notes = notes.filter((item) => item.id !== note.id);
            saveNotes();
            updatePanel();
          });

          actions.append(edit, remove);
          item.append(quote, content, date, actions);
          list.append(item);
        }
      }

      function openPanel() {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        root.classList.add('notes-open');
        articleLayout?.classList.add('notes-open');
      }

      function closePanelView() {
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        root.classList.remove('notes-open');
        articleLayout?.classList.remove('notes-open');
        closeForm();
      }

      function closeForm() {
        form.hidden = true;
        editingId = null;
        selectedQuote = '';
        contentInput.value = '';
      }

      function openForm(quote: string, note?: Note) {
        selectedQuote = quote;
        editingId = note?.id ?? null;
        formHeading.textContent = note ? '编辑笔记' : '添加笔记';
        quoteElement.textContent = quote;
        contentInput.value = note?.content ?? '';
        form.hidden = false;
        openPanel();
        contentInput.focus();
      }

      function hideSelectionAction() {
        selectionActions.hidden = true;
      }

      function updateSelectionAction() {
        const selection = window.getSelection();
        const text = selection?.toString().trim() ?? '';
        const anchor = selection?.anchorNode;

        if (!selection || selection.isCollapsed || !text || !anchor || !article.contains(anchor)) {
          if (!selectionAction.matches(':hover')) hideSelectionAction();
          return;
        }

        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        selectedQuote = text;
        selectedStart = getTextOffset(range.startContainer, range.startOffset);
        selectionActions.style.left = `${Math.min(Math.max(12, rect.left), window.innerWidth - 220)}px`;
        selectionActions.style.top = `${Math.min(rect.bottom + 8, window.innerHeight - 52)}px`;
        selectionActions.hidden = false;
      }

      toggle.addEventListener('click', () => {
        if (panel.hidden) {
          openPanel();
        } else {
          closePanelView();
        }
      });

      closePanel.addEventListener('click', closePanelView);

      cancelButton.addEventListener('click', closeForm);

      highlightAction.addEventListener('mousedown', (event) => event.preventDefault());
      highlightAction.addEventListener('click', () => {
        if (selectedQuote) {
          const highlight = { id: makeId(), quote: selectedQuote, start: selectedStart };
          if (applyHighlight(highlight)) {
            highlights.push(highlight);
            saveHighlights();
          }
        }
        hideSelectionAction();
      });

      selectionAction.addEventListener('mousedown', (event) => event.preventDefault());
      selectionAction.addEventListener('click', () => {
        if (selectedQuote) openForm(selectedQuote);
        hideSelectionAction();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const content = contentInput.value.trim();
        if (!content || !selectedQuote) return;

        const now = new Date().toISOString();
        if (editingId) {
          notes = notes.map((note) =>
            note.id === editingId ? { ...note, content, updatedAt: now } : note
          );
        } else {
          notes.unshift({ id: makeId(), quote: selectedQuote, content, createdAt: now, updatedAt: now });
        }

        saveNotes();
        updatePanel();
        closeForm();
      });

      document.addEventListener('selectionchange', updateSelectionAction);
      window.addEventListener('resize', updateSelectionAction);
      updatePanel();
      restoreHighlights();
    }
  }
</script>
