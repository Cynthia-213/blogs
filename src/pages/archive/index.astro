---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, postsByYear } from '../../lib/posts';

const posts = await getPublishedPosts();
const groups = postsByYear(posts);
const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Archive" description="按年份浏览所有文章。">
  <section class="page-heading">
    <p class="eyebrow">Archive</p>
    <h1>文章归档</h1>
    <p>所有公开文章按时间倒序排列。</p>
  </section>

  <div class="archive-list">
    {
      years.map((year) => (
        <section class="archive-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ul>
            {groups[year].map((post) => (
              <li>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
